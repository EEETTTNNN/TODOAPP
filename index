<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no, viewport-fit=cover">
  <title>TODOAPP</title>
  
  <!-- Configuration PWA iOS -->
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="apple-mobile-web-app-title" content="TODOAPP">
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 text-slate-800 font-sans min-h-screen flex flex-col justify-between pt-12 pb-6 px-4 select-none">

  <div class="max-w-md mx-auto w-full">
    <!-- En-tête -->
    <header class="mb-6 flex justify-between items-center">
      <h1 class="text-3xl font-extrabold text-slate-900 tracking-tight">TODOAPP</h1>
      <span id="counter" class="text-xs font-semibold uppercase tracking-wider bg-slate-200 text-slate-600 py-1 px-3 rounded-full">0 tâche</span>
    </header>

    <!-- Champ de saisie -->
    <form id="todo-form" class="flex gap-2 mb-6">
      <input 
        type="text" 
        id="todo-input" 
        placeholder="Ajouter une tâche..." 
        required
        class="flex-1 bg-white border border-slate-300 rounded-2xl px-4 py-3 text-base focus:outline-none focus:ring-2 focus:ring-slate-900 shadow-sm"
      >
      <button 
        type="submit" 
        class="bg-slate-900 text-white font-medium px-5 py-3 rounded-2xl active:scale-95 transition-transform shadow-sm"
      >
        +
      </button>
    </form>

    <!-- Liste des tâches -->
    <ul id="todo-list" class="space-y-3"></ul>
  </div>

  <script>
    const form = document.getElementById('todo-form');
    const input = document.getElementById('todo-input');
    const list = document.getElementById('todo-list');
    const counter = document.getElementById('counter');

    let todos = JSON.parse(localStorage.getItem('todoapp_tasks')) || [];

    function saveAndRender() {
      localStorage.setItem('todoapp_tasks', JSON.stringify(todos));
      render();
    }

    function toggleTask(id) {
      todos = todos.map(t => t.id === id ? { ...t, completed: !t.completed } : t);
      saveAndRender();
    }

    function deleteTask(id) {
      todos = todos.filter(t => t.id !== id);
      saveAndRender();
    }

    function render() {
      list.innerHTML = '';
      const activeCount = todos.filter(t => !t.completed).length;
      counter.textContent = `${activeCount} restante${activeCount > 1 ? 's' : ''}`;

      todos.forEach(todo => {
        const li = document.createElement('li');
        li.className = `flex items-center justify-between p-4 bg-white rounded-2xl shadow-sm border border-slate-200/60 transition-all ${todo.completed ? 'opacity-50' : ''}`;
        
        li.innerHTML = `
          <div class="flex items-center gap-3 flex-1 cursor-pointer" onclick="toggleTask(${todo.id})">
            <div class="w-6 h-6 rounded-full border-2 ${todo.completed ? 'bg-emerald-500 border-emerald-500' : 'border-slate-300'} flex items-center justify-center text-white text-xs font-bold">
              ${todo.completed ? '✓' : ''}
            </div>
            <span class="text-base ${todo.completed ? 'line-through text-slate-400' : 'text-slate-700 font-medium'}">${todo.text}</span>
          </div>
          <button onclick="deleteTask(${todo.id})" class="text-slate-300 hover:text-rose-500 p-1 text-lg leading-none">&times;</button>
        `;
        list.appendChild(li);
      });
    }

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const text = input.value.trim();
      if (!text) return;
      
      todos.unshift({ id: Date.now(), text, completed: false });
      input.value = '';
      saveAndRender();
    });

    render();
  </script>
</body>
</html>
